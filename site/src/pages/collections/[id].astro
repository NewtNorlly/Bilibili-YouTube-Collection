---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCatalog, getCollectionById } from "../../lib/catalog";
import { topicUrl, withBase } from "../../lib/url";

export async function getStaticPaths() {
  const catalog = await getCatalog();

  return catalog.collections.map((collection) => ({
    params: { id: collection.id },
  }));
}

const id = Astro.params.id ?? "";
const collection = await getCollectionById(id);

if (!collection) {
  throw new Error(`Collection not found: ${id}`);
}

const catalog = await getCatalog();
const notes = collection.notes.filter((note) => !note.draft);
const topics = catalog.topics.filter((topic) => topic.collectionId === collection.id);

const kindLabel = collection.kind === "library"
  ? "书库"
  : collection.kind === "series"
    ? "专题集"
    : "创作者合集";
---

<BaseLayout
  title={collection.name}
  description={collection.description || `${collection.name}的文本档案。`}
  canonicalPath={`/collections/${encodeURIComponent(collection.id)}/`}
>
  <div class="shell">
    <Breadcrumbs
      items={[
        { label: "首页", href: withBase("/") },
        { label: collection.name },
      ]}
    />
  </div>

  <header class="page-hero">
    <div class="shell page-hero__grid">
      <div>
        <p class="eyebrow">{kindLabel} · Collection</p>
        <h1>{collection.name}</h1>
        {collection.description && (
          <p class="page-hero__description">{collection.description}</p>
        )}
      </div>

      <ul class="page-hero__facts" aria-label="合集信息">
        <li><span>文本</span><strong>{notes.length} 篇</strong></li>
        <li><span>专题</span><strong>{topics.length} 个</strong></li>
        <li><span>归档类型</span><strong>{kindLabel}</strong></li>
      </ul>
    </div>
  </header>

  {topics.length > 0 && (
    <section class="listing-section">
      <div class="shell">
        <header class="section-heading">
          <h2 class="section-heading__title">专题</h2>
          <p class="section-heading__index">TOPICS / {String(topics.length).padStart(2, "0")}</p>
        </header>
        <ol class="topic-list">
          {topics.map((topic, index) => (
            <li>
              <a class="topic-link" href={topicUrl(topic.id)}>
                <span class="topic-link__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="topic-link__name">{topic.name}</span>
                <span class="topic-link__count">{topic.noteCount} 篇</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="listing-section">
    <div class="shell">
      <header class="section-heading">
        <h2 class="section-heading__title">全部文本</h2>
        <p class="section-heading__index">ENTRIES / {String(notes.length).padStart(2, "0")}</p>
      </header>

      {notes.length > 0 ? (
        <div class="entry-grid">
          {notes.map((note) => <EntryCard note={note} />)}
        </div>
      ) : (
        <p class="empty-state">这个合集暂时没有可发布的文本。</p>
      )}
    </div>
  </section>
</BaseLayout>
