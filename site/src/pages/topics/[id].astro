---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCatalog, getTopicById } from "../../lib/catalog";
import { collectionUrl, withBase } from "../../lib/url";

export async function getStaticPaths() {
  const catalog = await getCatalog();

  return catalog.topics.map((topic) => ({
    params: { id: topic.id },
  }));
}

const id = Astro.params.id ?? "";
const topic = await getTopicById(id);

if (!topic) {
  throw new Error(`Topic not found: ${id}`);
}

const notes = topic.notes.filter((note) => !note.draft);
---

<BaseLayout
  title={topic.name}
  description={`${topic.collectionName}中的${topic.name}专题文本。`}
  canonicalPath={`/topics/${encodeURIComponent(topic.id)}/`}
>
  <div class="shell">
    <Breadcrumbs
      items={[
        { label: "首页", href: withBase("/") },
        { label: topic.collectionName, href: collectionUrl(topic.collectionId) },
        { label: topic.name },
      ]}
    />
  </div>

  <header class="page-hero">
    <div class="shell page-hero__grid">
      <div>
        <p class="eyebrow">专题 · Topic</p>
        <h1>{topic.name}</h1>
      </div>

      <ul class="page-hero__facts" aria-label="专题信息">
        <li><span>所属合集</span><strong>{topic.collectionName}</strong></li>
        <li><span>收录文本</span><strong>{notes.length} 篇</strong></li>
        <li><span>归档类型</span><strong>独立专题</strong></li>
      </ul>
    </div>
  </header>

  <section class="listing-section">
    <div class="shell">
      <header class="section-heading">
        <h2 class="section-heading__title">专题文本</h2>
        <p class="section-heading__index">ENTRIES / {String(notes.length).padStart(2, "0")}</p>
      </header>

      {notes.length > 0 ? (
        <div class="entry-grid">
          {notes.map((note) => <EntryCard note={note} showCollection />)}
        </div>
      ) : (
        <p class="empty-state">这个专题暂时没有可发布的文本。</p>
      )}
    </div>
  </section>
</BaseLayout>
