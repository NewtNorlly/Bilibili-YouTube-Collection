---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeToggle from "../components/HomeToggle.astro";
import BookshelfModule from "../components/modules/BookshelfModule.astro";
import BloggersModule from "../components/modules/BloggersModule.astro";

const bookshelfActive = true;
const bloggersActive = false;
---

<BaseLayout
  title="我的书架 · 网络博主"
  description="个人内容收藏档案：微信读书书摘归档的「我的书架」，与 B 站 / YouTube 网络博主文本合集。"
  canonicalPath="/"
>
  <Fragment slot="header-center">
    <HomeToggle active="bookshelf" />
  </Fragment>
  <BookshelfModule active={bookshelfActive} />
  <BloggersModule active={bloggersActive} />
</BaseLayout>

<script>
  /* ════════════ 双模块切换（我的书架 / 网络博主） ════════════ */
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-module-target]");
  const panels = document.querySelectorAll<HTMLElement>("[data-module-panel]");
  const indicator = document.querySelector<HTMLElement>(".module-switch__indicator");

  function activateModule(name: "bookshelf" | "bloggers", updateHash = true) {
    panels.forEach((panel) => {
      panel.classList.toggle("is-active", panel.dataset.modulePanel === name);
    });
    tabs.forEach((tab) => {
      const on = tab.dataset.moduleTarget === name;
      tab.classList.toggle("is-active", on);
      tab.setAttribute("aria-selected", String(on));
    });
    if (indicator) indicator.dataset.active = name;
    if (updateHash) {
      const hash = name === "bloggers" ? "#bloggers" : "#bookshelf";
      if (location.hash !== hash) history.replaceState(null, "", hash);
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const name = (tab.dataset.moduleTarget ?? "bookshelf") as "bookshelf" | "bloggers";
      activateModule(name);
    });
  });

  /* 支持 #bookshelf / #bloggers 直达深链 */
  const initial = location.hash === "#bloggers" ? "bloggers" : "bookshelf";
  activateModule(initial, false);

  window.addEventListener("hashchange", () => {
    const name = location.hash === "#bloggers" ? "bloggers" : "bookshelf";
    activateModule(name, false);
  });
</script>
