---
import type { Note } from "../lib/catalog";
import { collectionUrl, noteUrl } from "../lib/url";
import Cover from "./Cover.astro";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const kindLabel = (kind: string) => (kind === "book" ? "书摘" : "文章");
---

<div class="carousel" id="featured-carousel">
  <div class="carousel__stage">
    {notes.map((note, index) => (
      <div
        class="carousel__card"
        data-index={index}
        style={`--card-index: ${index};`}
      >
        <a class="carousel__cover" href={noteUrl(note.id)} tabindex="-1" aria-hidden="true">
          <Cover cover={note.cover} title={note.title} eager={index === 0} />
        </a>
        <div class="carousel__body">
          <div class="carousel__meta">
            <span>{kindLabel(note.kind)}</span>
            <a href={collectionUrl(note.collectionId)}>{note.collectionName}</a>
          </div>
          <h3><a href={noteUrl(note.id)}>{note.title}</a></h3>
          {note.description && <p class="carousel__desc">{note.description}</p>}
        </div>
      </div>
    ))}
  </div>

  <div class="carousel__controls" aria-label="轮播控制">
    <button class="carousel__btn carousel__btn--prev" aria-label="上一篇">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="carousel__dots">
      {notes.map((_, index) => (
        <button
          class="carousel__dot"
          data-dot={index}
          aria-label={`第 ${index + 1} 篇`}
        ></button>
      ))}
    </div>
    <button class="carousel__btn carousel__btn--next" aria-label="下一篇">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</div>

<script>
  class FeaturedCarousel {
    root: HTMLElement;
    stage: HTMLElement;
    cards: HTMLElement[];
    dots: HTMLElement[];
    prevBtn: HTMLElement;
    nextBtn: HTMLElement;
    current: number;
    total: number;

    constructor(root: HTMLElement) {
      this.root = root;
      this.stage = root.querySelector('.carousel__stage')!;
      this.cards = [...root.querySelectorAll<HTMLElement>('.carousel__card')];
      this.dots = [...root.querySelectorAll<HTMLElement>('.carousel__dot')];
      this.prevBtn = root.querySelector('.carousel__btn--prev')!;
      this.nextBtn = root.querySelector('.carousel__btn--next')!;
      this.current = 0;
      this.total = this.cards.length;
      if (this.total === 0) return;

      this.#layout();
      this.#bind();
    }

    #layout() {
      this.cards.forEach((card: HTMLElement, i: number) => {
        card.classList.remove('is-active', 'is-prev', 'is-next', 'is-far-prev', 'is-far-next');
        const offset = i - this.current;
        if (offset === 0) card.classList.add('is-active');
        else if (offset === -1 || offset === this.total - 1) card.classList.add('is-prev');
        else if (offset === 1 || offset === -(this.total - 1)) card.classList.add('is-next');
        else if (offset < 0) card.classList.add('is-far-prev');
        else card.classList.add('is-far-next');
      });
      this.dots.forEach((dot: HTMLElement, i: number) => {
        dot.classList.toggle('is-active', i === this.current);
      });
    }

    #bind() {
      this.prevBtn.addEventListener('click', () => this.#go(-1));
      this.nextBtn.addEventListener('click', () => this.#go(1));
      this.dots.forEach((dot: HTMLElement, i: number) => dot.addEventListener('click', () => this.#goTo(i)));

      let startX = 0;
      let dragging = false;

      this.stage.addEventListener('pointerdown', (e: PointerEvent) => {
        startX = e.clientX;
        dragging = true;
        this.stage.style.transition = 'none';
      });

      this.stage.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const active = this.cards[this.current];
        if (active) active.style.setProperty('--drag-offset', `${dx}px`);
      });

      this.stage.addEventListener('pointerup', (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        this.stage.style.transition = '';
        const dx = e.clientX - startX;
        const active = this.cards[this.current];
        if (active) active.style.setProperty('--drag-offset', '0px');
        if (dx < -50) this.#go(1);
        else if (dx > 50) this.#go(-1);
      });

      this.stage.addEventListener('pointerleave', () => {
        if (!dragging) return;
        dragging = false;
        this.stage.style.transition = '';
        const active = this.cards[this.current];
        if (active) active.style.setProperty('--drag-offset', '0px');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') this.#go(-1);
        if (e.key === 'ArrowRight') this.#go(1);
      });
    }

    #go(direction: number) {
      this.current = (this.current + direction + this.total) % this.total;
      this.#layout();
    }

    #goTo(index: number) {
      this.current = index;
      this.#layout();
    }
  }

  const el = document.getElementById('featured-carousel');
  if (el) new FeaturedCarousel(el);
</script>
