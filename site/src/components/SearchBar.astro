---
import { withBase } from '../lib/url';

const searchIndexUrl = withBase('search-index.json');
---

<div class="search-bar" id="site-search" data-index-url={searchIndexUrl}>
  <button
    class="search-bar__toggle"
    aria-label="打开搜索"
    aria-expanded="false"
    aria-controls="search-panel"
    id="search-toggle"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
  </button>

  <div class="search-bar__panel" id="search-panel">
    <div class="search-bar__input-row">
      <svg class="search-bar__input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        class="search-bar__input"
        id="search-input"
        placeholder="搜索文章标题…"
        autocomplete="off"
      />
      <button class="search-bar__close" id="search-close" aria-label="关闭搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="search-bar__results" id="search-results"></div>
  </div>
</div>

<script>
  class SiteSearch {
    panel: HTMLElement;
    input: HTMLInputElement;
    results: HTMLElement;
    toggle: HTMLElement;
    close: HTMLElement;
    data: { title: string; collection: string; url: string }[] = [];
    loaded = false;

    constructor() {
      this.panel = document.getElementById('search-panel')!;
      this.input = document.getElementById('search-input')! as HTMLInputElement;
      this.results = document.getElementById('search-results')!;
      this.toggle = document.getElementById('search-toggle')!;
      this.close = document.getElementById('search-close')!;

      this.toggle.addEventListener('click', () => this.open(false));
      this.close.addEventListener('click', () => this.closePanel(false));
      this.input.addEventListener('input', () => this.filter());

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          this.open(true);
        }
        if (e.key === 'Escape') this.closePanel(true);
      });

      document.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (!this.panel.contains(target) && target !== this.toggle && !this.toggle.contains(target)) {
          this.closePanel(false);
        }
      });
    }

    async open(instant = false) {
      this.#setInstant(instant);
      this.panel.classList.add('is-open');
      this.toggle.setAttribute('aria-expanded', 'true');
      this.input.focus();
      if (!this.loaded) {
        await this.fetchIndex();
        this.loaded = true;
      }
    }

    closePanel(instant = false) {
      this.#setInstant(instant);
      this.panel.classList.remove('is-open');
      this.toggle.setAttribute('aria-expanded', 'false');
      this.input.value = '';
      this.results.innerHTML = '';
      if (instant) this.toggle.focus();
    }

    #setInstant(instant: boolean) {
      this.panel.classList.toggle('is-instant', instant);
      if (instant) {
        requestAnimationFrame(() => this.panel.classList.remove('is-instant'));
      }
    }

    async fetchIndex() {
      try {
        const searchRoot = document.getElementById('site-search');
        const res = await fetch(searchRoot?.dataset.indexUrl ?? '/search-index.json');
        this.data = await res.json();
      } catch {
        this.data = [];
      }
    }

    filter() {
      const q = this.input.value.trim().toLowerCase();
      if (!q || this.data.length === 0) {
        this.results.innerHTML = '';
        return;
      }
      const matches = this.data
        .filter((item) => item.title.toLowerCase().includes(q) || item.collection.toLowerCase().includes(q))
        .slice(0, 15);

      this.results.innerHTML = matches.length
        ? matches
            .map(
              (item) =>
                `<a class="search-bar__result" href="${item.url}">
                  <span class="search-bar__result-title">${this.#highlight(item.title, q)}</span>
                  <span class="search-bar__result-collection">${item.collection}</span>
                </a>`,
            )
            .join('')
        : '<p class="search-bar__empty">未找到匹配的文章</p>';
    }

    #highlight(text: string, q: string) {
      const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
    }
  }

  new SiteSearch();
</script>

<style>
  .search-bar {
    position: relative;
  }

  .search-bar__toggle {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      background-color var(--duration-press) ease,
      color var(--duration-press) ease,
      border-color var(--duration-press) ease,
      transform var(--duration-press) var(--ease-out);
  }

  .search-bar__toggle:active {
    transform: scale(0.97);
  }

  .search-bar__panel {
    position: absolute;
    z-index: 50;
    top: calc(100% + 0.6rem);
    right: 0;
    width: min(26rem, calc(100vw - 2rem));
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-md);
    background: var(--sheet);
    box-shadow: 0 16px 48px rgb(67 50 30 / 16%);
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity var(--duration-popover) var(--ease-out),
      transform var(--duration-popover) var(--ease-out);
  }

  .search-bar__panel.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .search-bar__panel.is-instant {
    transition: none;
  }

  .search-bar__input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .search-bar__input-icon {
    flex-shrink: 0;
    color: var(--ink-faint);
  }

  .search-bar__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--text-min);
    outline: none;
  }

  .search-bar__input::placeholder {
    color: var(--ink-faint);
  }

  .search-bar__close {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-faint);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--duration-quick) ease,
      color var(--duration-quick) ease,
      transform var(--duration-press) var(--ease-out);
  }

  .search-bar__close:active {
    transform: scale(0.97);
  }

  .search-bar__results {
    max-height: 22rem;
    overflow-y: auto;
  }

  :global(.search-bar__result) {
    display: block;
    padding: 0.7rem 1rem;
    text-decoration: none;
    transition: background-color var(--duration-quick) ease;
    border-bottom: 1px solid var(--line-soft);
  }

  :global(.search-bar__result:last-child) {
    border-bottom: 0;
  }

  :global(.search-bar__result-title) {
    display: block;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--text-min);
    line-height: 1.5;
  }

  :global(.search-bar__result-title mark) {
    background: rgb(164 59 40 / 15%);
    color: var(--vermillion-dark);
  }

  :global(.search-bar__result-collection) {
    display: block;
    margin-top: 0.2rem;
    color: var(--ink-faint);
    font-size: var(--text-min);
  }

  :global(.search-bar__empty) {
    padding: 1.5rem 1rem;
    color: var(--ink-faint);
    font-size: var(--text-min);
    text-align: center;
  }

  @media (max-width: 44rem) {
    .search-bar__panel {
      right: auto;
      left: 0;
      transform-origin: top left;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .search-bar__toggle:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--sheet);
    }

    .search-bar__close:hover,
    :global(.search-bar__result:hover) {
      background: var(--sheet-muted);
      color: var(--ink);
    }
  }
</style>
