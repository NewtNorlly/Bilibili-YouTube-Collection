---
import Cover from "../Cover.astro";
import { getCatalog, type CollectionSummary } from "../../lib/catalog";
import { collectionUrl } from "../../lib/url";

interface Props {
  active?: boolean;
}

const { active = false } = Astro.props;

const catalog = await getCatalog();

/* 网络博主 = 微信读书之外的所有合集 */
const collections = catalog.collections.filter((collection) => collection.kind !== "library");

/* ---------- 首字母索引 ---------- */
function pinyinFirst(c: string): string {
  const map: Record<string, string> = {
    啊: "A", 爱: "A", 安: "A",
    本: "B", 哔: "B", 渤: "B", 捕: "B", 北: "B",
    差: "C", 超: "C",
    大: "D", 盗: "D", 毒: "D",
    二: "E",
    耿: "G",
    何: "H", 河: "H", 黑: "H",
    加: "J", 江: "J", 具: "J",
    卡: "K",
    蓝: "L", 浪: "L", 历: "L", 聊: "L",
    麦: "M", 盲: "M", 木: "M",
    青: "Q", 棋: "Q",
    三: "S", 杉: "S", 十: "S", 孙: "S",
    王: "W", 威: "W", 微: "W", 唯: "W", 文: "W", 我: "W", 乌: "W",
    小: "X", 心: "X", 星: "X", 夏: "X",
    要: "Y", 一: "Y", 英: "Y", 硬: "Y", 于: "Y", 元: "Y", 原: "Y", 源: "Y",
    张: "Z", 周: "Z", 志: "Z", 最: "Z",
    日: "R",
  };
  return map[c] ?? (/^[a-zA-Z]$/.test(c) ? c.toUpperCase() : "#");
}

interface LetterGroup {
  letter: string;
  collections: CollectionSummary[];
}

const groups = new Map<string, CollectionSummary[]>();
for (const col of collections) {
  const first = [...col.name][0] ?? "#";
  const letter = pinyinFirst(first);
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter)!.push(col);
}

const sortedLetters = [...groups.keys()].sort((a, b) => {
  if (a === "#") return 1;
  if (b === "#") return -1;
  return a.localeCompare(b);
});

const letterGroups: LetterGroup[] = sortedLetters.map((letter) => ({
  letter,
  collections: groups.get(letter)!,
}));

const kindLabel = (kind: string) => (kind === "series" ? "专题集" : "创作者");

/* 微信公众号头像（mmhead）不是封面，按无封面处理 */
function usableCover<T extends { src?: string }>(cover: T | undefined): T | undefined {
  const src = cover?.src ?? "";
  return src.includes("mmhead") ? undefined : cover;
}
---

<section
  class:list={["module-panel", { "is-active": active }]}
  id="panel-bloggers"
  data-module-panel="bloggers"
  role="tabpanel"
  aria-labelledby="tab-bloggers"
>
  <div class="shell">
    <!-- ═══ 独立搜索 ═══ -->
    <div class="module-search">
      <div class="module-search__inner">
        <svg class="module-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="search"
          class="module-search__input"
          placeholder="搜索博主或合集…"
          aria-label="搜索网络博主"
          data-blog-search
          autocomplete="off"
        />
      </div>
    </div>

    <!-- ═══ 简约首字母导航（不显示数量小字） ═══ -->
    <nav class="blog-alpha" aria-label="按首字母筛选博主">
      <button type="button" class="blog-alpha__btn is-active" data-letter="" aria-pressed="true">全部</button>
      {letterGroups.map((g) => (
        <button
          type="button"
          class="blog-alpha__btn"
          data-letter={g.letter}
          aria-pressed="false"
        >
          {g.letter}
        </button>
      ))}
    </nav>

    <!-- ═══ 首字母分组 · 克制字母章 ═══ -->
    <div class="blog-groups" data-blog-groups>
      {letterGroups.map((g) => (
        <div class="blog-group" data-letter={g.letter}>
          <div class="blog-group__header">
            <span class="blog-group__letter" aria-hidden="true">{g.letter}</span>
          </div>
          <div class="blog-grid">
            {g.collections.map((col) => (
              <a
                class="blog-card"
                href={collectionUrl(col.id)}
                data-search-text={`${col.name} ${kindLabel(col.kind)}`.toLowerCase()}
              >
                <div class="blog-card__cover">
                  <Cover cover={usableCover(col.cover)} title={col.name} thumbnail />
                </div>
                <div class="blog-card__body">
                  <span class="blog-card__kind">{kindLabel(col.kind)}</span>
                  <h4 class="blog-card__name">{col.name}</h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="shelf-empty" data-blog-empty hidden>
      <p>没有找到匹配的博主</p>
    </div>

    {collections.length === 0 && <p class="empty-state">暂无网络博主内容。</p>}
  </div>
</section>

<script>
  // Bloggers module: letter filter + independent search
  const btns = document.querySelectorAll<HTMLButtonElement>(".blog-alpha__btn");
  const groupsEl = document.querySelectorAll<HTMLElement>(".blog-group");
  const searchInput = document.querySelector<HTMLInputElement>("[data-blog-search]");
  const emptyEl = document.querySelector<HTMLElement>("[data-blog-empty]");

  let activeLetter = "";
  let searchQuery = "";

  function applyFilters() {
    let totalVisible = 0;
    for (const group of groupsEl) {
      const letter = group.dataset.letter ?? "";
      const letterMatch = !activeLetter || letter === activeLetter;
      const groupCards = Array.from(group.querySelectorAll<HTMLElement>(".blog-card"));
      let groupVisible = 0;

      for (const card of groupCards) {
        const text = card.dataset.searchText ?? "";
        const searchMatch = !searchQuery || text.includes(searchQuery);
        const show = letterMatch && searchMatch;
        card.style.display = show ? "" : "none";
        if (show) groupVisible++;
      }

      group.style.display = letterMatch && groupVisible > 0 ? "" : "none";
      totalVisible += groupVisible;
    }

    if (emptyEl) emptyEl.hidden = totalVisible > 0;
  }

  for (const btn of btns) {
    btn.addEventListener("click", () => {
      for (const b of btns) {
        b.classList.remove("is-active");
        b.setAttribute("aria-pressed", "false");
      }
      btn.classList.add("is-active");
      btn.setAttribute("aria-pressed", "true");
      activeLetter = btn.dataset.letter ?? "";
      applyFilters();
    });
  }

  searchInput?.addEventListener("input", () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilters();
  });
</script>
